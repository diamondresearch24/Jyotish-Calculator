  "calculation": {
    "note": "Day divided into 8 equal parts from sunrise to sunset. Yamaganda is one part, position varies by weekday.",
    "formula": "part_duration = (sunset - sunrise) / 8; yama_start = sunrise + (sequence[weekday] * part_duration)",
    "sequence": {
      "0": 4, "1": 3, "2": 2, "3": 1, "4": 0, "5": 6, "6": 5
    }
  },
