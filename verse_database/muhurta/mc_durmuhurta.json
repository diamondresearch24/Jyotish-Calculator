  "calculation": {
    "note": "Day divided into 15 muhurtas (sunrise to sunset). Two are inauspicious, varying by weekday.",
    "muhurta_duration_minutes": 48,
    "formula": "muhurta_len = (sunset - sunrise) / 15; dur_start = sunrise + (sequence[weekday][0] * muhurta_len)",
    "sequence": {
      "0": [14, 10], "1": [7, 4], "2": [4, 3], "3": [10, 7], "4": [3, 14], "5": [1, 2], "6": [12, 8]
    }
  },
